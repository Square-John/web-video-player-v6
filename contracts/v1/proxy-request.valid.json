{
  "schemaVersion": "1.0.0",
  "protocolVersion": "1.0.0",
  "cases": [
    {
      "name": "https-get-json",
      "request": {
        "protocolVersion": "1.0.0",
        "requestId": "request-get-json",
        "sourceId": "source-a",
        "target": {
          "url": "https://example.com/api/content?page=1",
          "method": "GET"
        },
        "headers": {
          "accept": "application/json"
        },
        "body": {
          "encoding": "none",
          "data": null
        },
        "responseType": "json",
        "timeoutMs": 10000,
        "maxResponseBytes": 1048576
      }
    },
    {
      "name": "https-post-utf8",
      "request": {
        "protocolVersion": "1.0.0",
        "requestId": "request-post-utf8",
        "sourceId": "source-a",
        "target": {
          "url": "https://example.com/form",
          "method": "POST"
        },
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": {
          "encoding": "utf8",
          "data": "page=1&keyword=test"
        },
        "responseType": "text",
        "timeoutMs": 8000,
        "maxResponseBytes": 524288
      }
    },
    {
      "name": "https-post-json",
      "request": {
        "protocolVersion": "1.0.0",
        "requestId": "request-post-json",
        "sourceId": "source-b",
        "target": {
          "url": "https://example.com/api/search",
          "method": "POST"
        },
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "encoding": "json",
          "data": {
            "keyword": "demo",
            "page": 1
          }
        },
        "responseType": "json",
        "timeoutMs": 12000,
        "maxResponseBytes": 2097152
      }
    },
    {
      "name": "https-post-base64",
      "request": {
        "protocolVersion": "1.0.0",
        "requestId": "request-post-base64",
        "sourceId": "source-b",
        "target": {
          "url": "https://example.com/binary-query",
          "method": "POST"
        },
        "headers": {
          "content-type": "application/octet-stream"
        },
        "body": {
          "encoding": "base64",
          "data": "AQIDBA=="
        },
        "responseType": "arrayBuffer",
        "timeoutMs": 5000,
        "maxResponseBytes": 262144
      }
    }
  ]

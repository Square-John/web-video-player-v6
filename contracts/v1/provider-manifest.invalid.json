{
  "schemaVersion": "1.0.0",
  "providerApiVersion": "1.1.0",
  "baseManifest": {
    "schemaVersion": "1.0.0",
    "providerApiVersion": "1.1.0",
    "id": "source.com.example",
    "name": "示例数据源",
    "description": "用于非法向量的基础 manifest。",
    "version": "1.0.0",
    "providerKey": "source.com.example.provider",
    "capabilities": {
      "home": true,
      "movie": true,
      "tv": true,
      "search": true,
      "detail": true,
      "play": true
    },
    "settingsSchema": [],
    "networkHosts": ["example.com"]
  },
  "cases": [
    {
      "name": "unknown-field",
      "patch": { "unknownField": true },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest" }
    },
    {
      "name": "unsupported-manifest-schema-version",
      "patch": { "schemaVersion": "2.0.0" },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.schemaVersion" }
    },
    {
      "name": "unsupported-provider-api-version",
      "patch": { "providerApiVersion": "2.0.0" },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.providerApiVersion" }
    },
    {
      "name": "unsupported-future-provider-api-minor",
      "patch": { "providerApiVersion": "1.2.0" },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.providerApiVersion" }
    },
    {
      "name": "source-id-is-not-lowercase-ascii-namespace",
      "patch": {
        "id": "Source Example",
        "providerKey": "Source Example.provider"
      },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.id" }
    },
    {
      "name": "provider-key-does-not-match-id",
      "patch": { "providerKey": "different.provider" },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.providerKey" }
    },
    {
      "name": "wildcard-network-host",
      "patch": { "networkHosts": ["*.example.com"] },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.networkHosts" }
    },
    {
      "name": "network-host-includes-protocol",
      "patch": { "networkHosts": ["https://example.com"] },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.networkHosts" }
    },
    {
      "name": "network-host-is-ip-address",
      "patch": { "networkHosts": ["203.0.113.1"] },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.networkHosts" }
    },
    {
      "name": "network-host-is-not-lowercase",
      "patch": { "networkHosts": ["Example.com"] },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.networkHosts" }
    },
    {
      "name": "duplicate-network-host",
      "patch": { "networkHosts": ["example.com", "example.com"] },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.networkHosts" }
    },
    {
      "name": "missing-capability",
      "patch": {
        "capabilities": {
          "home": true,
          "movie": true,
          "tv": true,
          "search": true,
          "detail": true
        }
      },
      "expected": { "code": "SOURCE_PACKAGE_MANIFEST_INVALID", "field": "sourceManifest.capabilities" }
    }
  ]
}

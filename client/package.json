    "idb": "^8.0.3",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "xgplayer": "3.0.26",
    "xgplayer-hls": "3.0.26"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.3",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.24",
    "vite": "^5.4.0"
  }
}
